FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt

COPY src/main.py /app/main.py
COPY src/lidl.py /app/lidl.py
COPY manifest.json /app/manifest.json
COPY tests /app/tests

RUN mkdir -p /logs
ENV PYTHONUNBUFFERED=1

# Test 1: terminate action -> exit 0, emits result {cleaned:true}
RUN OUT=$(echo '{"_action":"terminate"}' | python3 /app/main.py) && \
    echo "$OUT" | grep -q '"cleaned":true' && \
    echo "PASS: terminate returns cleaned:true" || (echo "FAIL: terminate" && exit 1)

# Test 2: events.log is created (logging goes to file, not stdout)
RUN test -f /logs/events.log && echo "PASS: events.log exists" || (echo "FAIL: no events.log" && exit 1)

# Test 3: stdout carries ONLY JSON lines (no stray log output)
RUN echo '{"_action":"terminate"}' | python3 /app/main.py | \
    python3 -c 'import sys,json; [json.loads(l) for l in sys.stdin if l.strip()]' && \
    echo "PASS: stdout is valid JSON Lines" || (echo "FAIL: non-JSON on stdout" && exit 1)

# Test 4: missing outputPath -> input error (exit 2)
RUN echo '{"_action":"execute"}' | python3 /app/main.py; \
    EC=$?; if [ "$EC" -eq 2 ]; then echo "PASS: missing outputPath -> exit 2"; \
    else echo "FAIL: expected 2 got $EC" && exit 1; fi

# Test 5: unknown action -> input error (exit 2)
RUN echo '{"_action":"frobnicate"}' | python3 /app/main.py; \
    EC=$?; if [ "$EC" -eq 2 ]; then echo "PASS: unknown action -> exit 2"; \
    else echo "FAIL: expected 2 got $EC" && exit 1; fi

# Test 6: invalid JSON -> input error (exit 2)
RUN printf 'not json\n' | python3 /app/main.py; \
    EC=$?; if [ "$EC" -eq 2 ]; then echo "PASS: invalid JSON -> exit 2"; \
    else echo "FAIL: expected 2 got $EC" && exit 1; fi

# Test 7: --version matches manifest
RUN V=$(python3 /app/main.py --version) && \
    MV=$(python3 -c 'import json;print(json.load(open("/app/manifest.json"))["version"])') && \
    [ "$V" = "$MV" ] && echo "PASS: --version ($V) matches manifest" || \
    (echo "FAIL: version mismatch $V != $MV" && exit 1)

# Test 8: offline parser tests against the saved fixtures
RUN python3 /app/tests/test_parser.py

# Test 9: execute happy-path against the fixtures (file:// URLs, no network)
# flyerApiUrl uses a literal "{identifier}" placeholder resolved per-tile.
RUN OUT=$(echo '{"_action":"execute","outputPath":"/tmp/result.json","pageUrl":"file:///app/tests/fixtures/listing.html","flyerApiUrl":"file:///app/tests/fixtures/flyers/{identifier}.json","knownLeaflets":[]}' | python3 /app/main.py); \
    EC=$?; echo "$OUT" | grep -q '"hasNew":true' && echo "$OUT" | grep -q '"url"' && \
    echo "$OUT" | grep -q '\.pdf' && [ "$EC" -eq 0 ] && \
    test -s /tmp/result.json && echo "PASS: execute parses fixtures, hasNew=true, pdf {from,to,url}, exit 0" || \
    (echo "FAIL: got $EC: $OUT" && exit 1)

# Test 10: feed back the type|from|to keys as known -> hasNew=false
# (built + invoked entirely in Python to avoid fragile nested shell quoting)
RUN python3 -c '\
import json, subprocess, sys; \
d = json.load(open("/tmp/result.json")); \
keys = [e["type"] + "|" + e["from"] + "|" + e["to"] for e in d["leaflets"]]; \
payload = {"_action": "execute", "outputPath": "/tmp/r2.json", \
    "pageUrl": "file:///app/tests/fixtures/listing.html", \
    "flyerApiUrl": "file:///app/tests/fixtures/flyers/{identifier}.json", \
    "knownLeaflets": keys}; \
p = subprocess.run(["python3", "/app/main.py"], input=json.dumps(payload), \
    capture_output=True, text=True); \
ok = "\"hasNew\":false" in p.stdout; \
print("PASS: hasNew=false when all known" if ok else f"FAIL: {p.stdout} {p.stderr}"); \
sys.exit(0 if ok else 1)'

# Test 11: fetch failure -> dependency error (exit 4)
RUN echo '{"_action":"execute","outputPath":"/tmp/r3.json","pageUrl":"http://127.0.0.1:9/nope"}' \
    | python3 /app/main.py; \
    EC=$?; if [ "$EC" -eq 4 ]; then echo "PASS: fetch failure -> exit 4"; \
    else echo "FAIL: expected 4 got $EC" && exit 1; fi

RUN echo "=== All tests passed ==="
CMD ["echo", "All tests passed"]
